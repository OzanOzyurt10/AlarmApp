<Window x:Class="AlarmApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlarmApp"
        Title="Uydu Telemetri Kontrolcüsü" Height="650" Width="1250" Loaded="Window_Loaded"
        Background="#0F172A">
    <Window.Resources>
        <ObjectDataProvider x:Key="KarsilastirmaEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}" xmlns:System="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:KarsilastirmaTuru"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="BackgroundBorder" Width="45" Height="22" CornerRadius="11" Background="#334155" BorderThickness="0">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#94A3B8" HorizontalAlignment="Left" Margin="3,0,3,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="23" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="RowBackground" Value="#1E293B"/>
            <Setter Property="AlternatingRowBackground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Border x:Name="ToggleButtonBackground" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" 
                                       Text="▾" 
                                       Foreground="#64748B" 
                                       FontSize="14" 
                                       Margin="0,0,10,0" 
                                       VerticalAlignment="Center"/>
                                </Grid>
                            </Border>


                            <ToggleButton Background="Transparent" 
                                  BorderThickness="0" 
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                            <Popup x:Name="Popup" 
                           Placement="Bottom" 
                           IsOpen="{TemplateBinding IsDropDownOpen}" 
                           AllowsTransparency="True" 
                           Focusable="False" 
                           PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" 
                                Background="#0F172A" 
                                BorderBrush="#38BDF8" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                MinWidth="{TemplateBinding ActualWidth}" 
                                Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True" OverridesDefaultStyle="True">
                                        <ScrollViewer.Template>
                                            <ControlTemplate TargetType="ScrollViewer">
                                                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                            </ControlTemplate>
                                        </ScrollViewer.Template>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" 
                                    Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}" 
                                    CornerRadius="2" 
                                    Margin="2,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#334155"/>
                                            <Setter Property="Foreground" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#334155"/>
                                            <Setter Property="Foreground" Value="#38BDF8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ALARM KARTI SİLME BUTONU ================= -->
        <Style x:Key="AlarmKartSilButonu" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B1420"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= KART DÜZENLE BUTONU ================= -->
        <Style x:Key="AlarmKartDuzenleButonu" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F2E22"/>
                                <Setter Property="Foreground" Value="#4ADE80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= KRİTİKLİK ROZETİ ================= -->
        <Style x:Key="KritiklikRozeti" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Background" Value="{Binding KritiklikRengi}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="KritiklikRozetiMetni" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ================= ALARM KARTI DIŞ KABUK (paylaşılan) ================= -->
        <!-- Tek ve çok parametreli kartlar aynı kabuk stilini kullanır -->
        <Style x:Key="AlarmKartKabukStili" TargetType="Border">
            <Setter Property="Width" Value="272"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1B2436" Offset="0"/>
                        <GradientStop Color="#141B2B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#2A3550"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="12" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3E4E78"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" Opacity="0.42" BlurRadius="20" ShadowDepth="4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding Aktif}" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3B1220" Offset="0"/>
                                <GradientStop Color="#2A0D16" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#EF4444"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#EF4444" Opacity="0.6" BlurRadius="24" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= DURUM NOKTASI (nabız) ================= -->
        <Style x:Key="DurumNoktasiStili" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Aktif}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="NoktaNabzi">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                  From="1" To="0.25" Duration="0:0:0.6"
                                                  AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="NoktaNabzi"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= KAYNAK ETİKETİ (paket · parametre) ================= -->
        <Style x:Key="KartKaynakEtiketiStili" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- ================= ANLIK DEĞER KUTUSU ================= -->
        <Style x:Key="AlarmDegerKutusuStili" TargetType="Border">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
        </Style>

        <!-- ================= DURUM ROZETİ (alt) ================= -->
        <Style x:Key="AlarmDurumRozetiStili" TargetType="Border">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{Binding Renk}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="UniversalCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBox Text="{Binding EsikDegerObje, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                     Style="{StaticResource DarkTextBox}"
                                     Height="28">
                                        <TextBox.Resources>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HatalıMi}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                        <Setter Property="Background" Value="#451A1A"/>
                                                        <Setter Property="ToolTip" Value="{Binding HataMesaji}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TipAdi}" Value="Boolean">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding EsikDegerObje, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernSwitchStyle}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="AnlikVeriCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBox Text="{Binding AnlikDegerObje, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TipAdi}" Value="Boolean">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding AnlikDegerObje, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernSwitchStyle}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="MaxEsikCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Karsilastirma}" Value="Arasindadir">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MaxEsikDegerObje, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                             Style="{StaticResource DarkTextBox}"
                                             Height="28">
                                                <TextBox.Resources>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HatalıMi}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                <Setter Property="Background" Value="#451A1A"/>
                                                                <Setter Property="ToolTip" Value="{Binding HataMesaji}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Karsilastirma}" Value="Disindadir">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MaxEsikDegerObje, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}" Height="28"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding TipAdi}" Value="Boolean">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="---" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="🛰️ UYDU TELEMETRİ KONTROLCÜSÜ"
               FontSize="24"
               FontWeight="Bold"
               Foreground="#F8FAFC"/>

                <TextBlock Text="Veri Kısıtları ve Canlı Eşik Analiz Paneli"
               Foreground="#64748B"
               FontSize="13"
               Margin="0,4,0,10"/>


                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="🛰️ Uydu:"
                   Foreground="#94A3B8"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>


                    <ComboBox
                                Width="150"
                                ItemsSource="{Binding Uydular}"
                                SelectedItem="{Binding SeciliUydu}"
                                DisplayMemberPath="GosterimAdi"
                                Style="{StaticResource DarkComboBox}"/>
                </StackPanel>

            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">



                <!-- Üst Satır -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">




                    <Border CornerRadius="6"
                Padding="12,6"
                Margin="0,0,20,0"
                BorderThickness="1" Width="129" Height="34">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#7F1D1D"/>
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AktifAlarmSayisi}" Value="0">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⚠️ Aktif Alarm: "
                           FontSize="13"
                           FontWeight="SemiBold"
                           />

                            <TextBlock Text="{Binding AktifAlarmSayisi}"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,0"/>
                        </StackPanel>

                    </Border>
                    <!-- Veri Hızı -->
                    <Border Background="#1E293B"
        BorderBrush="#334155"
        BorderThickness="1"
        CornerRadius="6"
        Padding="12,6"
        Margin="0,0,12,0">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡"
                   FontSize="14"
                   Margin="0,0,6,0"/>

                            <StackPanel>
                                <TextBlock Text="VERİ HIZI"
                       FontSize="10"
                       Foreground="#94A3B8"/>

                                <TextBlock x:Name="txtVeriHizi"
                       Text="0 Hz"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#22C55E"/>
                            </StackPanel>
                        </StackPanel>

                    </Border>

                    <!-- Toplam Paket -->
                    <Border Background="#1E293B"
        BorderBrush="#334155"
        BorderThickness="1"
        CornerRadius="6"
        Padding="12,6"
        Margin="0,0,12,0">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦"
                   FontSize="14"
                   Margin="0,0,6,0"/>

                            <StackPanel>
                                <TextBlock Text="TOPLAM"
                       FontSize="10"
                       Foreground="#94A3B8"/>

                                <TextBlock x:Name="txtToplamPaket"
                       Text="0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="White"/>
                            </StackPanel>
                        </StackPanel>

                    </Border>

                    <TextBlock Text="🔊 Sesli Alarm:"
                   Foreground="#94A3B8"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>

                    <CheckBox x:Name="chkSesliAlarm"
                  Style="{StaticResource ModernSwitchStyle}"/>

                </StackPanel>

                <!-- Alt Satır -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <TextBlock Text="UDP Port:"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Margin="0,0,5,0"/>

                    <TextBox x:Name="txtUdpPort"
                                     Width="70"
                                     Text="5000"
                                     HorizontalContentAlignment="Center"/>

                    <Button x:Name="btnConnect"
                                Width="100"
                                Margin="8,0,0,0"
                                Content="Başlat"
                                Click="BtnBaglan_Click"/>

                    <Ellipse x:Name="ledBaglanti"
                                 Width="12"
                                 Height="12"
                                 Margin="10,0,0,0"
                                 Fill="Red"/>

                </StackPanel>
            </StackPanel>
        </Grid>


        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL TARAF : AKTİF ALARMLAR -->
            <!-- ================================================= -->
            <!-- SOL TARAF : ALARM PANELİ -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <!-- Filtre butonları -->
                    <RowDefinition Height="Auto"/>

                    <!-- Alarm kartları -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- ALARM FİLTRE BUTONLARI -->
                <!-- ================================================= -->

                <StackPanel
        Grid.Row="0"
        Orientation="Horizontal"
        Margin="0,0,0,12">

                    <!-- TÜMÜ -->

                    <RadioButton
            x:Name="rbTumAlarmlar"
            Content="TÜMÜ"
            GroupName="AlarmGorunumu"
            IsChecked="True"
            Margin="0,0,10,0"
            Padding="14,7"
            Foreground="White"
            FontWeight="Bold"
            Checked="rbTumAlarm_Checked"/>


                    <!-- TEK PARAMETRELİ -->

                    <RadioButton
            x:Name="rbTekParametreli"
            Content="TEK PARAMETRELİ"
            GroupName="AlarmGorunumu"
            Margin="0,0,10,0"
            Padding="14,7"
            Foreground="White"
            FontWeight="Bold"
            Checked="rbTekAlarm_Checked"/>


                    <!-- ÇOK PARAMETRELİ -->

                    <RadioButton
            x:Name="rbCokParametreli"
            Content="ÇOK PARAMETRELİ"
            GroupName="AlarmGorunumu"
            Padding="14,7"
            Foreground="White"
            FontWeight="Bold"
            Checked="rbCokAlarm_Checked"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- ALARM KARTLARI -->
                <!-- ================================================= -->

                <ScrollViewer
        Grid.Row="1"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

                    <Grid>


                        <!-- ================================================= -->
                        <!-- ALARM YOK MESAJI -->
                        <!-- ================================================= -->

                        <TextBlock
                Text="Henüz tanımlanmış alarm yok."
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="#64748B"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter
                            Property="Visibility"
                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                Binding="{Binding AlarmVarMi}"
                                Value="False">

                                            <Setter
                                    Property="Visibility"
                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>


                        <!-- ================================================= -->
                        <!-- ALARM KARTLARI -->
                        <!-- ================================================= -->

                        <StackPanel>


                            <!-- ================================================= -->
                            <!-- TEK PARAMETRELİ ALARMLAR -->
                            <!-- ================================================= -->

                            <ItemsControl
                    ItemsSource="{Binding TekParametreliAlarmKartlari}">

                                <ItemsControl.Style>

                                    <Style TargetType="ItemsControl">

                                        <Setter
                                Property="Visibility"
                                Value="Visible"/>

                                        <Style.Triggers>

                                            <DataTrigger
                                    Binding="{Binding TekAlarmlarGorunur}"
                                    Value="False">

                                                <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </ItemsControl.Style>


                                <ItemsControl.ItemsPanel>

                                    <ItemsPanelTemplate>

                                        <WrapPanel
                                Orientation="Horizontal"/>

                                    </ItemsPanelTemplate>

                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Style="{StaticResource AlarmKartKabukStili}">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- KRİTİKLİK RENK ŞERİDİ -->
                                                <Border
                                                    Grid.Column="0"
                                                    Background="{Binding KritiklikRengi}"
                                                    CornerRadius="18,0,0,18"/>

                                                <Grid Grid.Column="1">

                                                    <!-- DEKORATİF FİLİGRAN İKON -->
                                                    <TextBlock
                                                        Text="{Binding KritiklikIkon}"
                                                        FontSize="80"
                                                        Foreground="White"
                                                        Opacity="0.05"
                                                        IsHitTestVisible="False"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,6,6"/>

                                                    <StackPanel Margin="16,15,16,15">

                                                        <!-- KRİTİKLİK ROZETİ VE SİLME BUTONU -->
                                                        <Grid>
                                                            <Border Style="{StaticResource KritiklikRozeti}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding KritiklikIkon}" FontSize="10" Foreground="White" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding KritiklikMetni}" Style="{StaticResource KritiklikRozetiMetni}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button
                                                                    Content="✎"
                                                                    Style="{StaticResource AlarmKartDuzenleButonu}"
                                                                    Click="TekAlarmDuzenle_Click"
                                                                    Tag="{Binding}"
                                                                    Margin="0,0,4,0"/>

                                                                <Button
                                                                    Content="✕"
                                                                    Style="{StaticResource AlarmKartSilButonu}"
                                                                    Click="TekAlarmSil_Click"
                                                                    Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <!-- UYDU -->
                                                        <Border
                                                            Background="#1E3A5F"
                                                            CornerRadius="8"
                                                            Padding="8,3"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,12,0,0">

                                                            <TextBlock
                                                            Text="{Binding UyduId, StringFormat=🛰️ UYDU-{0}}"
                                                            Foreground="#BFDBFE"
                                                            FontSize="11"
                                                            FontWeight="Bold"/>
                                                        </Border>
                                                        <!-- BAŞLIK -->
                                                        <TextBlock
                                                            Text="{Binding Baslik}"
                                                            FontWeight="Bold"
                                                            FontSize="16"
                                                            Foreground="#F8FAFC"
                                                            Margin="0,12,0,0"
                                                            LineHeight="19"
                                                            TextWrapping="Wrap"/>

                                                        <!-- KAYNAK -->
                                                        <TextBlock Style="{StaticResource KartKaynakEtiketiStili}">
                                                            <Run Text="🛰️ "/>
                                                            <Run Text="{Binding PaketAdi, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding ParametreAdi, Mode=OneWay}"/>
                                                        </TextBlock>

                                                        <!-- AÇIKLAMA -->
                                                        <TextBlock
                                                            Text="{Binding Aciklama}"
                                                            Margin="0,7,0,0"
                                                            Foreground="#94A3B8"
                                                            FontSize="12"
                                                            LineHeight="16"
                                                            TextWrapping="Wrap"/>

                                                        <!-- ANLIK DEĞER -->
                                                        <Border Style="{StaticResource AlarmDegerKutusuStili}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{Binding KritiklikRengi}" CornerRadius="2" Margin="0,1,10,1"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock
                                                                        Text="ANLIK DEĞER"
                                                                        FontSize="9.5"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="#64748B"/>

                                                                    <TextBlock
                                                                        Text="{Binding AnlikDeger}"
                                                                        FontSize="17"
                                                                        FontWeight="Bold"
                                                                        Foreground="#38BDF8"
                                                                        Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <!-- DURUM -->
                                                        <Border Style="{StaticResource AlarmDurumRozetiStili}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Ellipse Style="{StaticResource DurumNoktasiStili}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock
                                                                    Text="{Binding Durum}"
                                                                    Foreground="White"
                                                                    FontWeight="Bold"
                                                                    FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>

                                                    </StackPanel>

                                                </Grid>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>


                            <!-- ================================================= -->
                            <!-- ÇOK PARAMETRELİ ALARMLAR -->
                            <!-- ================================================= -->

                            <ItemsControl
                    ItemsSource="{Binding CokParametreliAlarmKartlari}">

                                <ItemsControl.Style>

                                    <Style TargetType="ItemsControl">

                                        <Setter
                                Property="Visibility"
                                Value="Visible"/>

                                        <Style.Triggers>

                                            <DataTrigger
                                    Binding="{Binding CokAlarmlarGorunur}"
                                    Value="False">

                                                <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </ItemsControl.Style>


                                <ItemsControl.ItemsPanel>

                                    <ItemsPanelTemplate>

                                        <WrapPanel
                                Orientation="Horizontal"/>

                                    </ItemsPanelTemplate>

                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Style="{StaticResource AlarmKartKabukStili}">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- KRİTİKLİK RENK ŞERİDİ -->
                                                <Border
                                                    Grid.Column="0"
                                                    Background="{Binding KritiklikRengi}"
                                                    CornerRadius="18,0,0,18"/>

                                                <Grid Grid.Column="1">

                                                    <!-- DEKORATİF FİLİGRAN İKON -->
                                                    <TextBlock
                                                        Text="🔗"
                                                        FontSize="72"
                                                        Foreground="White"
                                                        Opacity="0.05"
                                                        IsHitTestVisible="False"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,6,6"/>

                                                    <StackPanel Margin="16,15,16,15">

                                                        <!-- KRİTİKLİK ROZETİ VE SİLME BUTONU -->
                                                        <Grid>
                                                            <Border Style="{StaticResource KritiklikRozeti}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding KritiklikIkon}" FontSize="10" Foreground="White" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding KritiklikMetni}" Style="{StaticResource KritiklikRozetiMetni}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button
                                                                    Content="✎"
                                                                    Style="{StaticResource AlarmKartDuzenleButonu}"
                                                                    Click="CokluAlarmDuzenle_Click"
                                                                    Tag="{Binding}"
                                                                    Margin="0,0,4,0"/>

                                                                <Button
                                                                    Content="✕"
                                                                    Style="{StaticResource AlarmKartSilButonu}"
                                                                    Click="CokluAlarmSil_Click"
                                                                    Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- BAŞLIK -->
                                                        <TextBlock
                                                            Text="{Binding Baslik}"
                                                            FontWeight="Bold"
                                                            FontSize="16"
                                                            Foreground="#F8FAFC"
                                                            Margin="0,12,0,0"
                                                            LineHeight="19"
                                                            TextWrapping="Wrap"/>

                                                        <!-- KAYNAK -->
                                                        <TextBlock Style="{StaticResource KartKaynakEtiketiStili}">
                                                            <Run Text="🔗 "/>
                                                            <Run Text="{Binding AlarmTuru, Mode=OneWay}"/>
                                                        </TextBlock>

                                                        <!-- AÇIKLAMA -->
                                                        <TextBlock
                                                            Text="{Binding Aciklama}"
                                                            Margin="0,7,0,0"
                                                            Foreground="#94A3B8"
                                                            FontSize="12"
                                                            LineHeight="16"
                                                            TextWrapping="Wrap"/>

                                                        <!-- DURUM -->
                                                        <Border Style="{StaticResource AlarmDurumRozetiStili}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Ellipse Style="{StaticResource DurumNoktasiStili}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock
                                                                    Text="{Binding Durum}"
                                                                    Foreground="White"
                                                                    FontWeight="Bold"
                                                                    FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                </Grid>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Grid>

                </ScrollViewer>

            </Grid>



            <!-- SAĞ TARAF : LOGLAR -->

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="343*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📋 LOG KAYITLARI"
                   Foreground="#94A3B8"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,0,0,5" Grid.ColumnSpan="2"/>

                <ListBox Grid.Row="1"
                 ItemsSource="{Binding SistemLoglari}"
                 Background="#0F172A"
                 BorderBrush="#334155"
                 Foreground="#10B981"
                 FontFamily="Consolas"
                 FontSize="11"
                 Padding="5" Grid.ColumnSpan="2"/>

            </Grid>

        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

            <Button x:Name="btnMantikIslemleri" 
                    Content="🚨 Alarm Oluştur" 
                    Width="176" Height="38" 
                    Margin="0,0,12,0" 
                    Background="#aa0606" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Click="btnMantikIslemleri_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="💾  Ayarları Uygula" 
            Width="180" Height="38" 
            IsEnabled="{Binding IsDirty}" 
            BorderThickness="0" 
            FontWeight="SemiBold" 
            Click="btnKaydet_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#10B981"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#064E3B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Grid>
</Window>