<Window x:Class="AlarmApp.AlarmDuzenle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarmı Düzenle"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22">

        <TextBlock Text="✏️  Alarmı Düzenle" Foreground="#4ADE80" FontSize="16" FontWeight="Bold"/>
        <TextBlock x:Name="txtAltBaslik"
                   Foreground="#94A3B8"
                   FontSize="11.5"
                   Margin="0,4,0,18"
                   TextWrapping="Wrap"/>

        <TextBlock Text="KRİTİKLİK SEVİYESİ" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="cmbKritiklik"
                  Style="{StaticResource DarkComboBox}"/>

        <StackPanel x:Name="pnlEsikAyarlari" Margin="0,18,0,0">

            <TextBlock Text="KARŞILAŞTIRMA" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6"/>
            <ComboBox x:Name="cmbKarsilastirma"
                      Style="{StaticResource DarkComboBox}"/>

            <TextBlock Text="EŞİK DEĞER" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="0,14,0,6"/>
            <TextBox x:Name="txtEsikDeger"/>
            <ComboBox x:Name="cmbBooleanEsik"
                      Style="{StaticResource DarkComboBox}"
                      Height="34"
                      Visibility="Collapsed">
                <ComboBoxItem Content="True"/>
                <ComboBoxItem Content="False"/>
            </ComboBox>

            <TextBlock x:Name="txtMaxEsikBaslik"
                       Text="MAKS. EŞİK DEĞER"
                       Foreground="#64748B"
                       FontSize="10.5"
                       FontWeight="Bold"
                       Margin="0,14,0,6"/>
            <TextBox x:Name="txtMaxEsikDeger"/>

        </StackPanel>

        <StackPanel x:Name="pnlBaglac"
                    Margin="0,18,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="BAĞLAÇ" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6"/>
            <ComboBox x:Name="cmbBaglac"
                      Style="{StaticResource DarkComboBox}"/>
        </StackPanel>

        <StackPanel x:Name="pnlKosullar"
                    Margin="0,18,0,0"
                    Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="btnIptal"
                    Content="Vazgeç"
                    Width="90"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="btnIptal_Click"
                    Background="Transparent"
                    Foreground="#94A3B8"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Cursor="Hand"/>
            <Button x:Name="btnKaydet"
                    Content="Kaydet"
                    Width="90"
                    Height="34"
                    Click="btnKaydet_Click"
                    Background="#4ADE80"
                    Foreground="#0B1220"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

    </StackPanel>

</Window>
